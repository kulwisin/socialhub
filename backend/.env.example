# Backend environment — copy to .env and fill in values
# See SECRET.md for generation instructions

APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:3000

# Database (Docker overrides the host with "postgres" automatically)
DATABASE_URL=postgresql://socialhub:socialhub@localhost:5432/socialhub

# Encryption key for stored tokens
ENCRYPTION_KEY=GENERATE_WITH_fernet

# Meta (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/auth/meta/callback
META_GRAPH_API_VERSION=v21.0

# TikTok (future)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Media storage
MEDIA_DIR=/app/media
