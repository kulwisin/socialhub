# ── Docker Compose root variables ─────────────────────────────────────────────
# Copy to .env — never commit .env

# PostgreSQL
POSTGRES_DB=socialhub
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=change-me-use-strong-password

# pgAdmin (dev only)
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin

# Production: your domain name
DOMAIN=yourdomain.com

# Production: email for Let's Encrypt certificate notifications
CERTBOT_EMAIL=admin@yourdomain.com

# Frontend public API URL (used at Docker build time in production)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_META_APP_ID=
